# Copy to .env and configure secrets/optional paths locally.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
MAX_CONCURRENT_WHISPER=1

# Model execution devices. Keep all but Whisper on CPU for a 4 GB GPU.
WHISPER_DEVICE=auto
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo
WHISPER_LORA_PATH=./models/after_chunk_01
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
NLLB_DEVICE=cpu
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_DEVICE=cpu
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
TTS_MODEL_ID=ai4bharat/indic-parler-tts
TTS_URL=http://127.0.0.1:8002

# Optional Hugging Face paths. Empty values use Hugging Face defaults.
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_TOKEN=

KNOWLEDGE_BASE_DIR=./knowledge_base
VECTOR_STORE_DIR=./data/vector_store
TOP_K=5
INITIAL_TOP_K=10
BGE_EMBEDDING_URL=http://127.0.0.1:8005
RETRIEVAL_URL=http://127.0.0.1:8004
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
SERVICE_TIMEOUT_SECONDS=30
